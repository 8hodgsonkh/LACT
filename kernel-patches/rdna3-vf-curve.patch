+/*
+ * Decode an IEEE 754 single-precision float stored as uint32 to an
+ * integer value in MHz.  Droop_PWL_F[] entries are zone boundary
+ * frequencies in GHz (e.g. 0x40000000 = 2.0 GHz = 2000 MHz).
+ *
+ * We must avoid FPU ops in kernel space, so this is pure integer math.
+ * Only positive, finite, "normal" values matter; everything else
+ * (zero, denorm, inf, nan, negative) returns 0.
+ */
+static uint32_t droop_pwl_f_to_mhz(uint32_t raw)
+{
+	uint32_t exp_biased, mantissa;
+	uint64_t significand;
+	int shift;
+
+	if (raw == 0 || (raw >> 31))
+		return 0;
+
+	exp_biased = (raw >> 23) & 0xFF;
+	mantissa   = raw & 0x7FFFFF;
+	significand = (1ULL << 23) | mantissa;
+	shift = 150 - (int)exp_biased;
+
+	return (shift >= 0 && shift < 32) ?
+		(uint32_t)(significand * 1000 >> shift) : 0;
+}
